# Variables del despliegue. Copia a .env en la VM y NUNCA lo subas al repositorio.
# Genera secretos con:  openssl rand -base64 48
PUBLIC_URL=http://localhost
HTTP_PORT=80
MYSQL_DATABASE=nexusfisi
MYSQL_USER=nexusfisi
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=8h
LOG_LEVEL=info
# Cookie de sesión solo por HTTPS: "auto" la activa en producción. Pon "false" solo si pruebas por http sin TLS.
COOKIE_SECURE=auto
# Correo saliente (recuperación de contraseña y avisos). Gmail: contraseña de APLICACIÓN.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Solo en demostraciones: desvía todos los correos a esta casilla.
MAIL_REDIRECT_TO=
# Mostrar el recuadro de cuentas demo en el login (true en demostraciones, false en producción real)
MOSTRAR_DEMO=true
# Imágenes publicadas por CI/CD
REGISTRY=ghcr.io/priscilacc17
TAG=latest
