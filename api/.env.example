# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.
NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://nexusfisi:nexusfisi_dev@127.0.0.1:3317/nexusfisi
# Genera uno propio: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=reemplaza-esto-por-un-secreto-aleatorio-de-48-bytes
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
LOG_LEVEL=info
TRUST_PROXY=false
MIGRATE_ON_START=true
AUTH_RATE_LIMIT=10
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=auto
STORAGE_DRIVER=disk
# Correo saliente. Gmail: contraseña de aplicación (no la contraseña normal).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Demostraciones: desvía TODOS los correos a esta casilla (las cuentas demo no son buzones reales).
MAIL_REDIRECT_TO=
MAIL_NOTIFICACIONES=true
DATABASE_SSL=false
DATABASE_SSL_CA=
SEED_DEMO_ON_START=false
